# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub. NUNCA pongas valores reales aquí.
# ─────────────────────────────────────────────────────────────

# URL del proyecto de Supabase (Project Settings → API → Project URL)
SUPABASE_URL=

# Clave secreta de Supabase (Project Settings → API Keys → "secret" o "service_role").
# Solo se usa en el servidor. Jamás debe llevar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Código de estudiante de la administradora (formato A00xxxxxx).
ADMIN_CODE=

# (Opcional) Contraseña extra para entrar a Administración.
# Si la defines, además del código se pedirá esta contraseña.
ADMIN_PASSWORD=

# Secreto para firmar las sesiones. Mínimo 32 caracteres aleatorios.
SESSION_SECRET=
